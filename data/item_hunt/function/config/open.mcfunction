# Item Hunt config menu (clickable chat). Replaces the 1.21.6 dialog (not available in 1.21.1).
# Must be run by an operator. Buttons re-run this function to redraw with the new state.
#
# Every label and hover is a reference into storage item_hunt:lang, filled by
# item_hunt:lang/apply from lang/es or lang/en. That keeps the highlight logic
# below in ONE place instead of one copy per language -- which is also the only
# place menu bugs ever live. Text goes in the lang files, never here.
# Not referenced on purpose, because they read the same in both languages:
# [ON]/[OFF], [Global]/[Silent], the dimension and language button labels, and
# the tick preset hovers.

tellraw @s [""]
tellraw @s {"nbt":"m_header","storage":"item_hunt:lang","interpret":true}
tellraw @s [""]
# Items por dia (1-7)
tellraw @s ["",{"nbt":"m_count","storage":"item_hunt:lang","interpret":true},{"text":"[-]","color":"red","bold":true,"clickEvent":{"action":"run_command","value":"/function item_hunt:config/count_dec"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_count_dec_h","storage":"item_hunt:lang","interpret":true}}},{"text":"  "},{"score":{"name":"count","objective":"item_hunt_config"},"color":"yellow","bold":true},{"text":"  "},{"text":"[+]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/function item_hunt:config/count_inc"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_count_inc_h","storage":"item_hunt:lang","interpret":true}}}]

# Pool de items por dimension (Overworld / Nether / End). Cumulativo.
#   Overworld = solo Overworld | Nether = Overworld+Nether | End = Overworld+Nether+End
execute if score dimension item_hunt_config matches 1 run tellraw @s ["",{"nbt":"m_pool","storage":"item_hunt:lang","interpret":true},{"text":"[Overworld]","color":"dark_green","bold":true,"clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_dimension {dim:1}"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_pool_ow_h","storage":"item_hunt:lang","interpret":true}}},{"text":" "},{"text":"[Nether]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_dimension {dim:2}"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_pool_ne_h","storage":"item_hunt:lang","interpret":true}}},{"text":" "},{"text":"[End]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_dimension {dim:3}"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_pool_end_h","storage":"item_hunt:lang","interpret":true}}}]
execute if score dimension item_hunt_config matches 2 run tellraw @s ["",{"nbt":"m_pool","storage":"item_hunt:lang","interpret":true},{"text":"[Overworld]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_dimension {dim:1}"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_pool_ow_h","storage":"item_hunt:lang","interpret":true}}},{"text":" "},{"text":"[Nether]","color":"dark_red","bold":true,"clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_dimension {dim:2}"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_pool_ne_h","storage":"item_hunt:lang","interpret":true}}},{"text":" "},{"text":"[End]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_dimension {dim:3}"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_pool_end_h","storage":"item_hunt:lang","interpret":true}}}]
execute if score dimension item_hunt_config matches 3 run tellraw @s ["",{"nbt":"m_pool","storage":"item_hunt:lang","interpret":true},{"text":"[Overworld]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_dimension {dim:1}"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_pool_ow_h","storage":"item_hunt:lang","interpret":true}}},{"text":" "},{"text":"[Nether]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_dimension {dim:2}"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_pool_ne_h","storage":"item_hunt:lang","interpret":true}}},{"text":" "},{"text":"[End]","color":"dark_purple","bold":true,"clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_dimension {dim:3}"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_pool_end_h","storage":"item_hunt:lang","interpret":true}}}]

# Buff a top players (0-5)
tellraw @s ["",{"nbt":"m_topbuff","storage":"item_hunt:lang","interpret":true},{"text":"[-]","color":"red","bold":true,"clickEvent":{"action":"run_command","value":"/function item_hunt:config/topbuff_dec"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_topbuff_dec_h","storage":"item_hunt:lang","interpret":true}}},{"text":"  "},{"score":{"name":"topbuff","objective":"item_hunt_config"},"color":"yellow","bold":true},{"text":"  "},{"text":"[+]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/function item_hunt:config/topbuff_inc"},"hoverEvent":{"action":"show_text","contents":{"nbt":"m_topbuff_inc_h","storage":"item_hunt:lang","interpret":true}}}]

