tellraw @s ["",{"nbt":"m_ticks","storage":"item_hunt:lang","interpret":true},{"score":{"name":"ticks","objective":"item_hunt_config"},"color":"yellow","bold":true}]
tellraw @s ["",{"text":"  "},{"text":"[24h]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_ticks {ticks:1728000}"},"hoverEvent":{"action":"show_text","contents":"1728000 ticks (24h)"}},{"text":" "},{"text":"[12h]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_ticks {ticks:864000}"},"hoverEvent":{"action":"show_text","contents":"864000 ticks (12h)"}},{"text":" "},{"text":"[6h]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_ticks {ticks:432000}"},"hoverEvent":{"action":"show_text","contents":"432000 ticks (6h)"}},{"text":" "},{"text":"[3h]","color":"aqua","clickEvent":{"action":"run_command","value":"/function item_hunt:config/set_ticks {ticks:216000}"},"hoverEvent":{"action":"show_text","contents":"216000 ticks (3h)"}}]
